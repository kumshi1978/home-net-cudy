#!/bin/sh
# Explicit lab adapter for already provisioned AmneziaWG interfaces.
set -eu
umask 077

config=/etc/home-net/vpn
backup=$config/transaction/backup
verb=$1
shift
if [ "$verb" = capabilities ]; then
    printf '%s\n' 'awg_main awg_backup awg_backup2'
    exit 0
fi

slot() {
    case "$1" in awg_main|awg_backup|awg_backup2) ;; *) return 1 ;; esac
}

quiescent() {
    # The supported Failover release shares the controller's inherited lock.
    contract=$(cat "$config/failover-lock-version" 2>/dev/null || true)
    supported=0
    case "$contract" in 1.4.2|1.5.0) supported=1 ;; esac
    if [ "$supported" = 1 ] &&
        grep -Fxq "INSTALLED_VERSION='$contract'" /etc/podkop-awg-failover.conf 2>/dev/null &&
        [ /proc/self/fd/9 -ef /var/run/home-net-vpn-maintenance.lock ] &&
        flock -n 9; then
        return 0
    fi
    # Older or independently invoked writers must remain quiescent.
    for writer in podkop-awg-failover podkop-health podkop-late-start; do
        init=/etc/init.d/$writer
        if [ -x "$init" ] && "$init" enabled; then return 1; fi
        status=$(ubus call service list "{\"name\":\"$writer\"}") || return 1
        case "$status" in *\""$writer"\"*) return 1 ;; esac
        if pidof "$writer" >/dev/null 2>&1; then return 1; fi
    done
}

section=$(cat "$config/podkop-section")
case "$section" in ''|*[!A-Za-z0-9_]*) exit 1 ;; esac
option=podkop.$section.interface

active() {
    [ "$(uci -q get "podkop.$section.connection_type")" = vpn ] || return 1
    selected=$(uci -q get "$option") || return 1
    slot "$selected" || return 1
    printf '%s\n' "$selected"
}

validate() {
    # A single-peer awg syncconf file. IP addresses and routing stay with netifd.
    awk '
        /^[[:space:]]*($|#)/ { next }
        /^[[:space:]]*\[Interface\][[:space:]]*$/ && section == 0 { section=1; next }
        /^[[:space:]]*\[Peer\][[:space:]]*$/ && section == 1 { section=2; next }
        {
            pos=index($0,"=")
            if (!pos) exit 1
            key=substr($0,1,pos-1)
            value=substr($0,pos+1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
            if (value == "" || seen[key]++) exit 1
            if (section == 1 && key ~ /^(PrivateKey|ListenPort|Jc|Jmin|Jmax|S[1-4]|H[1-4]|I[1-5])$/) next
            if (section == 2 && key ~ /^(PublicKey|PresharedKey|AllowedIPs|Endpoint|PersistentKeepalive|AdvancedSecurity)$/) next
            exit 1
        }
        END {
            if (section != 2 || !seen["PrivateKey"] || !seen["PublicKey"] ||
                !seen["AllowedIPs"] || !seen["Endpoint"]) exit 1
        }
    ' "$1"
}

endpoint_host() {
    awk '
        function valid(value, octet, pair, i) {
            if (split(value, pair, ":") != 2 || pair[2] !~ /^[0-9]+$/ || pair[2] < 1 || pair[2] > 65535) return 0
            if (split(pair[1], octet, /[.]/) != 4) return 0
            for (i=1; i<=4; i++) if (octet[i] !~ /^(0|[1-9][0-9]*)$/ || octet[i] > 255) return 0
            host=pair[1]
            return 1
        }
        { if (valid($1)) { count++; result=host } }
        END { if (count != 1) exit 1; print result }
    '
}

different_endpoint() {
    current=$(awg show "$1" endpoints) || return 1
    active_host=$(printf '%s\n' "$current" | awk '{print $2}' | endpoint_host) || return 1
    candidate_host=$(awk -F= '$1 ~ /^[[:space:]]*Endpoint[[:space:]]*$/ {print $2}' "$2" | endpoint_host) || return 1
    [ "$active_host" != "$candidate_host" ]
}

hash_conf() {
    [ -n "$1" ] || return 1
    printf '%s\n' "$1" | sha256sum | cut -d ' ' -f 1
}

fingerprint() {
    # Capture command failure before hashing. Never print showconf.
    conf=$(awg showconf "$1") || return 1
    hash_conf "$conf"
}

healthy() {
    # Podkop initializes the configuration and exits; sing-box serves traffic.
    home-net-install-verify services >/dev/null &&
        timeout 10 nslookup github.com 127.0.0.1 >/dev/null
}

probe() {
    ip=$(curl -q -4 --noproxy '*' --interface "if!$1" --connect-timeout 5 \
        --max-time 10 --max-filesize 128 -fsS https://ifconfig.me/ip) || return 1
    printf '%s\n' "$ip" | awk -F . '
        NF != 4 { bad=1 }
        { for (i=1; i<=NF; i++) if ($i !~ /^[0-9]+$/ || $i > 255) bad=1 }
        END { exit (NR != 1 || bad) }
    ' || return 1
    handshake=$(awg show "$1" latest-handshakes) || return 1
    now=$(date +%s) || return 1
    since=0
    if [ -n "$2" ]; then since=$(cat "$backup/staged-at") || return 1; fi
    printf '%s\n' "$handshake" | awk -v now="$now" -v since="$since" '
        NF != 2 || $2 !~ /^[0-9]+$/ || $2 <= since || $2 > now || now-$2 > 180 { bad=1 }
        END { exit (NR != 1 || bad) }
    ' || return 1
    # Country databases may disagree or change after provisioning. Country
    # is diagnostic metadata, never a condition for accepting a working tunnel.
    # Instead, verify that the bound tunnel exits through its intended VDS.
    endpoint=$(awg show "$1" endpoints | awk '{print $2}' | endpoint_host) || return 1
    [ "$ip" = "$endpoint" ] || return 1
}

switch_to() {
    # Match Failover's runtime UCI behavior. Persisting this is a later operation.
    uci set "$option=$1" &&
        timeout 45 /etc/init.d/podkop restart 9>&- || return 1
    # procd returns before the new proxy and firewall rules are ready.
    deadline=$(( $(date +%s) + 20 ))
    until healthy; do
        [ "$(date +%s)" -lt "$deadline" ] || return 1
        sleep 1
    done
}

matches_candidate() {
    [ "$(fingerprint "$1")" = "$(cat "$backup/candidate.sha256")" ] &&
        [ -s "$backup/candidate.sha256" ]
}

quiescent
case "$verb:$#" in
    active:0) active ;;
    prepared-address:2)
        slot "$1"
        [ "$(active)" != "$1" ]
        if ip link show dev "$1" >/dev/null 2>&1; then exit 1; fi
        [ "$(uci -q get "network.$1.proto")" = amneziawg ]
        [ "$(uci -q get "network.$1.home_net_prepared")" = 1 ]
        [ "$(uci -q get "network.$1.auto")" = 0 ]
        [ "$(uci -q get "network.$1.defaultroute")" = 0 ]
        [ "$(uci -q get "network.$1.peerdns")" = 0 ]
        [ "$(uci -q get "network.$1.addresses")" = "$2" ]
        ! uci -q show network | grep -q "=amneziawg_$1$"
        ;;
    validate:2)
        slot "$1"
        validate "$2"
        different_endpoint "$(active)" "$2"
        ;;
    snapshot:3)
        slot "$1"; slot "$2"
        [ "$(active)" = "$1" ]
        healthy
        if ! ip link show dev "$2" >/dev/null 2>&1; then
            [ "$(uci -q get "network.$2.proto")" = amneziawg ]
            [ "$(uci -q get "network.$2.auto")" = 0 ]
            [ "$(uci -q get "network.$2.defaultroute")" = 0 ]
            [ "$(uci -q get "network.$2.peerdns")" = 0 ]
            # An existing disabled peer may carry unknown routes; do not start it blindly.
            ! uci -q show network | grep -q "=amneziawg_$2$"
            : >"$3/target-was-down"
            if ! timeout 15 ifup "$2"; then
                timeout 15 ifdown "$2" || true
                exit 1
            fi
            # netifd acknowledges ifup before creating the device.
            attempts=0
            until awg showconf "$2" >/dev/null 2>&1; do
                attempts=$((attempts + 1))
                if [ "$attempts" -ge 15 ]; then
                    timeout 15 ifdown "$2" || true
                    exit 1
                fi
                sleep 1
            done
        fi
        awg showconf "$2" >"$3/target.conf"
        [ -s "$3/target.conf" ]
        conf=$(cat "$3/target.conf")
        hash_conf "$conf" >"$3/baseline.sha256"
        ;;
    stage:3)
        slot "$1"; slot "$2"
        [ "$1" != "$2" ] && [ "$(active)" = "$1" ] || exit 1
        validate "$3"
        different_endpoint "$1" "$3" || exit 1
        [ "$(fingerprint "$2")" = "$(cat "$backup/baseline.sha256")" ]
        date +%s >"$backup/staged-at"
        awg syncconf "$2" "$3"
        fingerprint "$2" >"$backup/candidate.sha256"
        ;;
    verify:3)
        slot "$1"; slot "$2"
        [ "$(active)" = "$1" ]
        matches_candidate "$2"
        probe "$2" "$3"
        healthy
        ;;
    persist:2)
        slot "$1"; slot "$2"
        [ "$(active)" = "$1" ]
        matches_candidate "$2"
        /usr/bin/home-net-vpn-persist.py "$2" "$(cat "$backup/candidate.sha256")"
        ;;
    promote:2)
        slot "$1"; slot "$2"
        [ "$(active)" = "$1" ]
        matches_candidate "$2"
        : >"$backup/promotion-started"
        switch_to "$2"
        ;;
    check-promoted:2)
        slot "$1"
        [ "$(active)" = "$1" ]
        matches_candidate "$1"
        probe "$1" "$2"
        healthy
        ;;
    restore:3)
        slot "$1"; slot "$2"
        [ "$1" != "$2" ]
        selected=$(active)
        # A failed restart can leave the UCI selection ahead of the daemon.
        if [ "$selected" != "$1" ] || [ -f "$3/promotion-started" ]; then
            switch_to "$1"
        fi
        [ "$(active)" = "$1" ]
        if [ -f "$3/network.before-persist" ]; then /usr/bin/home-net-vpn-persist.py --restore; fi
        awg syncconf "$2" "$3/target.conf"
        ;;
    check-restored:3)
        slot "$1"; slot "$2"
        [ "$(active)" = "$1" ]
        [ "$(fingerprint "$2")" = "$(cat "$3/baseline.sha256")" ]
        if [ -f "$3/target-was-down" ]; then timeout 15 ifdown "$2"; fi
        probe "$1" ""
        healthy
        ;;
    *) exit 1 ;;
esac
