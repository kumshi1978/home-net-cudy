#!/bin/sh
# HOME NET Cudy
# Фоновый монитор состояния Podkop / sing-box / AmneziaWG
# Версия: 1.4.1-dev
#
# Генерирует только состояние системы.
# События обрабатывает podkop-event-monitor.

CONF="/etc/podkop-service-check.conf"
CHECK="/usr/bin/podkop-service-check"

TAG="podkop-service-health"
LOG_DIR="/tmp/podkop-service-health"
STATE_FILE="$LOG_DIR/state"
KEEP_DAYS=14

[ -r "$CONF" ] && . "$CONF"
INTERVAL="${CHECK_INTERVAL:-300}"

mkdir -p "$LOG_DIR"

log() { logger -t "$TAG" "$*"; }

rotate_logs() {
    NOW=$(date +%s)
    for FILE in "$LOG_DIR"/service-*.log; do
        [ -f "$FILE" ] || continue
        MTIME=$(stat -c %Y "$FILE" 2>/dev/null || echo "$NOW")
        AGE=$(( (NOW - MTIME) / 86400 ))
        [ "$AGE" -gt "$KEEP_DAYS" ] && rm -f "$FILE"
    done
}

get_country() { curl -4 --interface "$1" --connect-timeout 5 --max-time 10 -fsS https://ipinfo.io/country 2>/dev/null; }
get_ip() { curl -4 --interface "$1" --connect-timeout 5 --max-time 10 -fsS https://ifconfig.me/ip 2>/dev/null; }
get_wan_ip() { curl -4 --connect-timeout 5 --max-time 10 -fsS https://ifconfig.me/ip 2>/dev/null; }

check_fakeip() { /usr/bin/podkop-fakeip-check >/dev/null 2>&1; }

check_singbox() {
    ubus call service list '{"name":"sing-box"}' | grep -q '"running": true'
}

check_podkop() {
    ubus call service list '{"name":"podkop"}' | grep -q '"running": true'
}

write_state() {
    TMP="$STATE_FILE.tmp"
    ACTIVE="$(uci -q get podkop.main.interface || echo unknown)"
    ACTIVE_IP="$(get_ip "$ACTIVE")"
    ACTIVE_COUNTRY="$(get_country "$ACTIVE")"
    WAN_IP="$(get_wan_ip)"
    WAN_COUNTRY="$(get_country "$ACTIVE")"

    STATUS="OK"

    [ "$ACTIVE_IP" = "$WAN_IP" ] && STATUS="FAIL" && log "VPN BYPASS DETECTED"
    [ "$ACTIVE_COUNTRY" = "RU" ] && STATUS="FAIL" && log "VPN COUNTRY RU DETECTED"

    if check_singbox; then SING_BOX="RUNNING"; else SING_BOX="FAIL"; STATUS="FAIL"; fi
    if check_podkop; then PODKOP="RUNNING"; else PODKOP="FAIL"; STATUS="FAIL"; fi
    if check_fakeip; then FAKEIP="OK"; else FAKEIP="FAIL"; STATUS="FAIL"; log "FAKEIP CHECK FAILED"; fi

    {
        echo "STATUS=$STATUS"
        echo "ACTIVE_VPN=$ACTIVE"
        echo "ACTIVE_IP=$ACTIVE_IP"
        echo "ACTIVE_COUNTRY=$ACTIVE_COUNTRY"
        echo "WAN_IP=$WAN_IP"
        echo "WAN_COUNTRY=$WAN_COUNTRY"
        echo "PODKOP=$PODKOP"
        echo "SING_BOX=$SING_BOX"
        echo "FAKEIP=$FAKEIP"
        echo "LAST_CHECK=$(date '+%F %T')"
    } > "$TMP"

    mv "$TMP" "$STATE_FILE"
}

write_daily_log() {
    DATE="$(date +%F)"
    FILE="$LOG_DIR/service-$DATE.log"
    { echo; echo "$(date '+%F %T')"; echo "$RESULT"; } >> "$FILE"
}

while true
do
    rotate_logs
    RESULT="$($CHECK 2>&1)"
    write_daily_log
    write_state

    if [ "$STATUS" = "OK" ]; then log "HOME NET OK active=$(uci -q get podkop.main.interface)"; else log "HOME NET WARNING"; fi
    sleep "$INTERVAL"
done
