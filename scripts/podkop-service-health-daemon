#!/bin/sh
# HOME NET Cudy
# Фоновый монитор состояния Podkop / sing-box / AmneziaWG
# Версия: 1.4.1
#
# Генерирует состояние системы и передаёт обновление в event pipeline.

CONF="/etc/podkop-service-check.conf"
CHECK="/usr/bin/podkop-service-check"
EVENT_RUNNER="/usr/bin/podkop-event-runner"

TAG="podkop-service-health"
LOG_DIR="/tmp/podkop-service-health"
STATE_FILE="$LOG_DIR/state"
KEEP_DAYS=14

[ -r "$CONF" ] && . "$CONF"
INTERVAL="${CHECK_INTERVAL:-300}"

mkdir -p "$LOG_DIR"

log() { logger -t "$TAG" "$*"; }

rotate_logs() {
    NOW=$(date +%s)
    for FILE in "$LOG_DIR"/service-*.log; do
        [ -f "$FILE" ] || continue
        MTIME=$(stat -c %Y "$FILE" 2>/dev/null || echo "$NOW")
        AGE=$(( (NOW - MTIME) / 86400 ))
        [ "$AGE" -gt "$KEEP_DAYS" ] && rm -f "$FILE"
    done
}

get_country() {
    curl -4 --interface "$1" --connect-timeout 5 --max-time 10 -fsS https://ipinfo.io/country 2>/dev/null | tr -d '\r\n'
}

get_ip() {
    curl -4 --interface "$1" --connect-timeout 5 --max-time 10 -fsS https://ifconfig.me/ip 2>/dev/null
}

get_wan_ip() {
    curl -4 --connect-timeout 5 --max-time 10 -fsS https://ifconfig.me/ip 2>/dev/null
}

get_direct_country() {
    curl -4 --connect-timeout 5 --max-time 10 -fsS https://ipinfo.io/country 2>/dev/null | tr -d '\r\n'
}

check_fakeip() { /usr/bin/podkop-fakeip-check >/dev/null 2>&1; }

check_singbox() {
    ubus call service list '{"name":"sing-box"}' 2>/dev/null | grep -q '"running": true'
}

check_podkop() {
    nft list table inet PodkopTable >/dev/null 2>&1 || return 1
    ip rule show 2>/dev/null | grep -Eq 'lookup[[:space:]]+podkop([[:space:]]|$)' || return 1
    return 0
}

set_unknown() {
    if [ "$STATUS" = "OK" ]; then
        STATUS="UNKNOWN"
        [ -n "${1:-}" ] && log "$1"
    fi
}

set_fail() {
    STATUS="FAIL"
}

mark_check_started() {
    START_TMP="$STATE_FILE.started.tmp"
    if [ -r "$STATE_FILE" ]; then
        grep -v '^CHECK_STARTED=' "$STATE_FILE" > "$START_TMP"
    else
        echo "STATUS=UNKNOWN" > "$START_TMP"
    fi
    echo "CHECK_STARTED=$CHECK_STARTED" >> "$START_TMP"
    mv "$START_TMP" "$STATE_FILE"
}

write_state() {
    TMP="$STATE_FILE.tmp"
    ACTIVE="$(uci -q get podkop.main.interface || echo unknown)"
    ACTIVE_IP=""
    ACTIVE_COUNTRY=""
    WAN_IP=""
    WAN_COUNTRY=""
    MAIN_COUNTRY=""
    BACKUP_COUNTRY=""
    STATUS="OK"
    SERVICE_CHECK="SKIPPED"

    if check_singbox; then SING_BOX="RUNNING"; else SING_BOX="FAIL"; set_fail; log "SING-BOX CHECK FAILED"; fi
    if check_podkop; then PODKOP="RUNNING"; else PODKOP="FAIL"; set_fail; log "PODKOP NFT/IP RULE CHECK FAILED"; fi
    if [ "$STATUS" = "OK" ]; then
        if check_fakeip; then FAKEIP="OK"; else FAKEIP="FAIL"; set_fail; log "FAKEIP CHECK FAILED"; fi
    else
        FAKEIP="SKIPPED"
    fi

    # External checks are ordered and fail-fast. Empty mandatory values are
    # UNKNOWN, never OK, and prevent a cascade of further DNS/HTTP timeouts.
    if [ "$STATUS" = "OK" ]; then
        ACTIVE_IP="$(get_ip "$ACTIVE")"
        [ -n "$ACTIVE_IP" ] || set_unknown "ACTIVE IP CHECK UNKNOWN"
    fi

    if [ "$STATUS" = "OK" ]; then
        ACTIVE_COUNTRY="$(get_country "$ACTIVE")"
        if [ -z "$ACTIVE_COUNTRY" ]; then
            set_unknown "ACTIVE COUNTRY CHECK UNKNOWN"
        elif [ "$ACTIVE_COUNTRY" = "RU" ]; then
            set_fail
            log "VPN COUNTRY RU DETECTED"
        fi
    fi

    if [ "$STATUS" = "OK" ]; then
        WAN_IP="$(get_wan_ip)"
        if [ -z "$WAN_IP" ]; then
            set_unknown "WAN IP CHECK UNKNOWN"
        elif [ "$ACTIVE_IP" = "$WAN_IP" ]; then
            set_fail
            log "VPN BYPASS DETECTED"
        fi
    fi

    if [ "$STATUS" = "OK" ]; then
        WAN_COUNTRY="$(get_direct_country)"
        [ -n "$WAN_COUNTRY" ] || set_unknown "WAN COUNTRY CHECK UNKNOWN"
    fi

    if [ "$STATUS" = "OK" ]; then
        MAIN_COUNTRY="$(get_country awg_main)"
        [ -n "$MAIN_COUNTRY" ] || set_unknown "AWG MAIN COUNTRY CHECK UNKNOWN"
    fi

    if [ "$STATUS" = "OK" ]; then
        BACKUP_COUNTRY="$(get_country awg_backup)"
        [ -n "$BACKUP_COUNTRY" ] || set_unknown "AWG BACKUP COUNTRY CHECK UNKNOWN"
    fi

    if [ "$STATUS" = "OK" ]; then
        RESULT="$($CHECK 2>&1)"
        CHECK_RC=$?
        case "$CHECK_RC" in
            0) SERVICE_CHECK="OK" ;;
            1) SERVICE_CHECK="FAIL"; set_fail ;;
            2) SERVICE_CHECK="UNKNOWN"; set_unknown "SERVICE CHECK UNKNOWN" ;;
            *) SERVICE_CHECK="FAIL"; set_fail; log "SERVICE CHECK INVALID EXIT CODE: $CHECK_RC" ;;
        esac
    else
        RESULT="SERVICE CHECK SKIPPED: base health status is $STATUS"
    fi

    LAST_CHECK="$(date '+%F %T')"
    CHECK_FINISHED_EPOCH="$(date +%s)"
    CHECK_DURATION_SEC=$((CHECK_FINISHED_EPOCH - CHECK_STARTED_EPOCH))

    {
        echo "STATUS=$STATUS"
        echo "ACTIVE_VPN=$ACTIVE"
        echo "ACTIVE_IP=$ACTIVE_IP"
        echo "ACTIVE_COUNTRY=$ACTIVE_COUNTRY"
        echo "WAN_IP=$WAN_IP"
        echo "WAN_COUNTRY=$WAN_COUNTRY"
        echo "AWG_MAIN_COUNTRY=$MAIN_COUNTRY"
        echo "AWG_BACKUP_COUNTRY=$BACKUP_COUNTRY"
        echo "PODKOP=$PODKOP"
        echo "SING_BOX=$SING_BOX"
        echo "FAKEIP=$FAKEIP"
        echo "SERVICE_CHECK=$SERVICE_CHECK"
        echo "CHECK_STARTED=$CHECK_STARTED"
        echo "LAST_CHECK=$LAST_CHECK"
        echo "CHECK_DURATION_SEC=$CHECK_DURATION_SEC"
    } > "$TMP"

    mv "$TMP" "$STATE_FILE"
}

run_event_pipeline() {
    [ -x "$EVENT_RUNNER" ] || return 0
    "$EVENT_RUNNER" || log "EVENT RUNNER FAILED"
}

write_daily_log() {
    DATE="$(date +%F)"
    FILE="$LOG_DIR/service-$DATE.log"
    { echo; echo "$(date '+%F %T')"; echo "$RESULT"; } >> "$FILE"
}

while true
do
    rotate_logs
    CHECK_STARTED_EPOCH="$(date +%s)"
    CHECK_STARTED="$(date '+%F %T')"
    mark_check_started
    write_state
    write_daily_log
    run_event_pipeline

    if [ "$STATUS" = "OK" ]; then log "HOME NET OK active=$(uci -q get podkop.main.interface)"; else log "HOME NET $STATUS"; fi
    sleep "$INTERVAL"
done
