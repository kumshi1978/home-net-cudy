#!/bin/sh
# HOME NET Cudy
# Проверка FakeIP DNS от Podkop/sing-box
# Версия: 1.4.1

CONF="/etc/podkop-service-check.conf"

[ -r "$CONF" ] && . "$CONF"

# Only domains that are expected to use VPN/FakeIP belong here.
# UniFi direct-exclusion domains must not be used as mandatory FakeIP probes.
FAKEIP_DOMAINS="${FAKEIP_DOMAINS:-github.com claude.ai gemini.google.com}"

check_fakeip() {
    HOST="$1"

    IP=$(nslookup "$HOST" 127.0.0.1 2>/dev/null | awk '/Address: 198\.18\./ {print $2; exit}')

    if [ -n "$IP" ]; then
        echo "$HOST OK $IP"
        return 0
    fi

    echo "$HOST FAIL"
    return 1
}

FAIL=0

for HOST in $FAKEIP_DOMAINS
do
    check_fakeip "$HOST" || FAIL=1
done

exit $FAIL
