#!/bin/sh
# HOME NET Cudy
# Country lookup with bounded provider fallback
# Version: 1.4.3

MODE=country
if [ "${1:-}" = --ip ]; then MODE=ip; shift; fi
IFACE="${1:-}"
case "$IFACE" in *[!a-zA-Z0-9_.-]*) exit 2 ;; esac
TAG="podkop-country"
LOG_DIR="${PODKOP_COUNTRY_LOG_DIR:-/tmp/podkop-service-health/country-provider-log}"
LOG_INTERVAL="${PODKOP_COUNTRY_LOG_INTERVAL:-3600}"
CURL_BIN="${PODKOP_COUNTRY_CURL:-curl}"

log_once() {
    key="$1"
    shift
    now="$(date +%s)"
    mkdir -p "$LOG_DIR"
    marker="$LOG_DIR/$key"
    last=0
    [ -r "$marker" ] && last="$(cat "$marker" 2>/dev/null || echo 0)"
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    if [ $((now - last)) -ge "$LOG_INTERVAL" ]; then
        logger -t "$TAG" "$*"
        printf '%s\n' "$now" > "$marker.tmp.$$"
        mv "$marker.tmp.$$" "$marker"
    fi
}

fetch_body() {
    url="$1"
    if [ -n "$IFACE" ]; then
        "$CURL_BIN" -4 --interface "$IFACE" --connect-timeout 5 --max-time 10 --max-filesize 4096 -fsS -w '\n%{http_code}' "$url" 2>/dev/null
    else
        "$CURL_BIN" -4 --connect-timeout 5 --max-time 10 --max-filesize 4096 -fsS -w '\n%{http_code}' "$url" 2>/dev/null
    fi
}

valid_country() {
    case "$1" in
        [A-Z][A-Z]) return 0 ;;
        *) return 1 ;;
    esac
}

lookup_provider() {
    provider="$1"
    url="$2"
    format="$3"

    scope="${IFACE:-direct}"
    cooldown="$LOG_DIR/cooldown-$scope-$provider"
    now="$(date +%s)"
    until=0
    [ ! -r "$cooldown" ] || until="$(cat "$cooldown" 2>/dev/null)"
    case "$until" in ''|*[!0-9]*) until=0 ;; esac
    [ "$until" -le "$now" ] || return 1
    response="$(fetch_body "$url")"
    rc=$?
    code="$(printf '%s\n' "$response" | tail -n 1)"
    body="$(printf '%s\n' "$response" | sed '$d')"
    case "$code" in [0-9][0-9][0-9]) ;; *) code=000 ;; esac
    if [ "$rc" -ne 0 ] || [ "$code" != 200 ]; then
        log_once "failed-$scope-$provider" "$MODE provider $provider failed interface=$scope http=$code curl=$rc"
        if [ "$code" = 429 ]; then
            printf '%s\n' "$((now + 900))" > "$cooldown.tmp.$$"
            mv "$cooldown.tmp.$$" "$cooldown"
        fi
        return 1
    fi

    case "$format" in
        plain) country="$(printf '%s' "$body" | tr -d '\r\n')" ;;
        json)
            case "$body" in
                *'"error"'*) country="" ;;
                *) country="$(printf '%s' "$body" | sed -n 's/.*"country"[[:space:]]*:[[:space:]]*"\([A-Z][A-Z]\)".*/\1/p')" ;;
            esac
            ;;
        ipv4)
            country="$(printf '%s' "$body" | tr -d '\r\n')"
            if ! printf '%s\n' "$country" | awk -F. 'NF != 4 {exit 1} {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || length($i)>3 || $i+0>255) exit 1}'; then
                country=""
            fi
            ;;
        *) return 1 ;;
    esac

    if { [ "$MODE" = country ] && ! valid_country "$country"; } || [ -z "$country" ]; then
        log_once "invalid-$scope-$provider" "$MODE provider $provider failed interface=$scope http=$code reason=invalid_body"
        return 1
    fi

    COUNTRY_RESULT="$country"
    return 0
}

COUNTRY_RESULT=""
if [ "$MODE" = ip ]; then
    if lookup_provider ifconfig https://ifconfig.me/ip ipv4 || lookup_provider ipify https://api.ipify.org ipv4; then
        [ "$provider" = ifconfig ] || log_once "used-ip-$scope" "IP fallback provider $provider used interface=$scope"
        printf '%s\n' "$COUNTRY_RESULT"
        exit 0
    fi
    exit 1
fi
if lookup_provider ipinfo https://ipinfo.io/country plain; then
    printf '%s\n' "$COUNTRY_RESULT"
    exit 0
fi

if lookup_provider ipapi https://ipapi.co/country plain; then
    log_once used-ipapi "fallback provider ipapi used"
    printf '%s\n' "$COUNTRY_RESULT"
    exit 0
fi

if lookup_provider country-is https://api.country.is/ json; then
    log_once used-country-is "fallback provider country-is used"
    printf '%s\n' "$COUNTRY_RESULT"
    exit 0
fi

exit 1
