#!/bin/sh
# HOME NET Cudy
# Проверка состояния Podkop, AmneziaWG и доступности сервисов
# Версия: 1.4.0-dev

TAG="podkop-service-check"

log() {
    logger -t "$TAG" "$*"
}

check_country()
{
    NAME="$1"
    IFACE="$2"

    echo "--- $NAME ($IFACE) ---"

    IP=$(curl -4 --interface "$IFACE" --connect-timeout 5 --max-time 10 -fsS https://ifconfig.me/ip 2>/dev/null)
    COUNTRY=$(curl -4 --interface "$IFACE" --connect-timeout 5 --max-time 10 -fsS https://ipinfo.io/country 2>/dev/null)

    echo "IP:      $IP"
    echo "Country: $COUNTRY"

    if [ "$COUNTRY" = "RU" ] || [ -z "$COUNTRY" ]; then
        echo "STATUS: FAIL"
        return 1
    fi

    echo "STATUS: OK"
}

check_url()
{
    NAME="$1"
    URL="$2"

    printf "%-18s " "$NAME"

    CODE=$(curl -4 -L -s -o /dev/null -w "%{http_code}" --connect-timeout 10 --max-time 20 "$URL")

    case "$CODE" in
        200|301|302|401|403)
            echo "OK ($CODE)"
            return 0
            ;;
        *)
            echo "FAIL ($CODE)"
            return 1
            ;;
    esac
}

FAIL=0

echo "===== VPN TUNNELS ====="
check_country "AWG MAIN" awg_main || FAIL=1
check_country "AWG BACKUP" awg_backup || FAIL=1

echo "===== PODKOP ROUTING ====="
for d in github.com unifi.ui.com ui.com claude.ai gemini.google.com huggingface.co perplexity.ai
do
    echo -n "$d -> "
    nslookup "$d" 127.0.0.1 2>/dev/null | grep Address | tail -1
done

check_url "GitHub" "https://github.com" || FAIL=1
check_url "GitHub API" "https://api.github.com" || FAIL=1
check_url "GitHub RAW" "https://raw.githubusercontent.com" || FAIL=1
check_url "UniFi" "https://unifi.ui.com" || FAIL=1
check_url "Ubiquiti" "https://ui.com" || FAIL=1
check_url "Anthropic" "https://claude.ai" || FAIL=1
check_url "Google AI" "https://gemini.google.com" || FAIL=1
check_url "HuggingFace" "https://huggingface.co" || FAIL=1
check_url "Perplexity" "https://perplexity.ai" || FAIL=1

[ "$FAIL" = 0 ]
