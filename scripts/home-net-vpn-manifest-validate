#!/bin/sh
set -eu

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

manifest=${1:-}
[ -n "$manifest" ] || fail "usage: home-net-vpn-manifest-validate MANIFEST"
[ -r "$manifest" ] || fail "manifest not readable"

# Reject obvious secret-bearing field names before sourcing.
if grep -Eiq '(^|[[:space:]_])(private.?key|preshared.?key|password|secret|token)[[:space:]]*=' "$manifest"; then
    fail "manifest contains a forbidden secret field"
fi

# Only simple uppercase assignments and comments are accepted.
if grep -Ev '^[[:space:]]*($|#|[A-Z0-9_]+='''[^''']*'''[[:space:]]*)$' "$manifest" | grep -q .; then
    fail "manifest contains unsupported syntax"
fi

# shellcheck disable=SC1090
. "$manifest"

[ "${FORMAT_VERSION:-}" = "1" ] || fail "FORMAT_VERSION must be 1"

case "${DEPLOYMENT_ID:-}" in
    ''|*[!A-Za-z0-9._-]*) fail "invalid DEPLOYMENT_ID" ;;
esac

case "${COUNTRY:-}" in
    [A-Z][A-Z]) ;;
    *) fail "COUNTRY must be a two-letter uppercase code" ;;
esac

case "${TARGET_SLOT:-}" in
    awg_main|awg_backup) ;;
    *) fail "TARGET_SLOT must be awg_main or awg_backup" ;;
esac

[ -n "${CREATED_AT:-}" ] || fail "CREATED_AT missing"
[ -n "${ROUTERS:-}" ] || fail "ROUTERS missing"

seen=""
for router in $ROUTERS; do
    case "$router" in
        apartment-main|apartment-backup|dacha-main|dacha-backup) ;;
        *) fail "unknown router id: $router" ;;
    esac
    case " $seen " in
        *" $router "*) fail "duplicate router id: $router" ;;
    esac
    seen="$seen $router"
done

for required in apartment-main apartment-backup dacha-main dacha-backup; do
    case " $seen " in
        *" $required "*) ;;
        *) fail "required router missing: $required" ;;
    esac
done

echo "PASS: deployment manifest $DEPLOYMENT_ID is valid"
