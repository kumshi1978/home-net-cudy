#!/bin/sh
# HOME NET LuCI status backend
# Version: 1.7.0

HEALTH_STATE="/tmp/podkop-service-health/state"
UPDATE_STATE="/etc/home-net-update.state"
UPDATE_CONF="/etc/home-net-update.conf"
ROLLOUT_STATE="/tmp/home-net-update/rollout.state"
FAILOVER_CONF="/etc/podkop-awg-failover.conf"
PROBLEM_LOG="/tmp/home-net-log/problems.log"
HEALTH_DIR="/tmp/podkop-service-health"

state_value() {
    key="$1"; file="$2"
    [ -r "$file" ] || return 0
    sed -n "s/^$key=//p" "$file" | tail -n 1 | sed "s/^'//;s/'$//"
}

health_value() {
    state_value "$1" "$HEALTH_STATE"
}

awg_handshake_age() {
    iface="$1"
    now="$(date +%s)"
    hs="$(awg show "$iface" latest-handshakes 2>/dev/null | awk 'NR==1 {print $2}')"
    case "$hs" in ''|*[!0-9]*) echo unknown; return ;; esac
    [ "$hs" -gt 0 ] || { echo never; return; }
    echo $((now - hs))
}

update_local_value() {
    key="$1"
    state_value "$key" "$UPDATE_CONF"
}

rollout_local_model() {
    capable="$(update_local_value HOME_NET_AUTO_UPDATE_CAPABLE)"
    ring="$(update_local_value HOME_NET_ROLLOUT_RING)"
    if [ -z "$capable" ] && [ -z "$ring" ]; then
        legacy_mode="$(update_local_value HOME_NET_UPDATE_MODE)"
        legacy_canary="$(update_local_value HOME_NET_UPDATE_CANARY)"
        [ "$legacy_mode" = "apply" ] && capable=1 || capable=0
        [ "$legacy_canary" = "1" ] && ring=canary || ring=stable
    fi
    [ -n "$capable" ] || capable=0
    [ -n "$ring" ] || ring=stable
}

status_cmd() {
    rollout_local_model
    echo "STATUS=$(health_value STATUS)"
    echo "ACTIVE_VPN=$(health_value ACTIVE_VPN)"
    echo "ACTIVE_IP=$(health_value ACTIVE_IP)"
    echo "ACTIVE_COUNTRY=$(health_value ACTIVE_COUNTRY)"
    echo "WAN_IP=$(health_value WAN_IP)"
    echo "WAN_COUNTRY=$(health_value WAN_COUNTRY)"
    echo "AWG_MAIN_COUNTRY=$(health_value AWG_MAIN_COUNTRY)"
    echo "AWG_BACKUP_COUNTRY=$(health_value AWG_BACKUP_COUNTRY)"
    echo "PODKOP=$(health_value PODKOP)"
    echo "SING_BOX=$(health_value SING_BOX)"
    echo "FAKEIP=$(health_value FAKEIP)"
    echo "SERVICE_CHECK=$(health_value SERVICE_CHECK)"
    echo "LAST_CHECK=$(health_value LAST_CHECK)"
    echo "CHECK_DURATION_SEC=$(health_value CHECK_DURATION_SEC)"
    echo "AWG_MAIN_HANDSHAKE_AGE=$(awg_handshake_age awg_main)"
    echo "AWG_BACKUP_HANDSHAKE_AGE=$(awg_handshake_age awg_backup)"
    echo "BUNDLE_INSTALLED=$(state_value INSTALLED_VERSION "$UPDATE_STATE")"
    echo "BUNDLE_ACTIVE=$(state_value ACTIVE_VERSION "$UPDATE_STATE")"
    echo "UPDATE_STATUS=$(state_value UPDATE_STATUS "$UPDATE_STATE")"
    echo "UPDATE_RING=$ring"
    echo "AUTO_UPDATE_CAPABLE=$capable"
    echo "LATEST_RELEASE=$(state_value LATEST_RELEASE "$ROLLOUT_STATE")"
    echo "RELEASE_ACTION_CLASS=$(state_value RELEASE_ACTION_CLASS "$ROLLOUT_STATE")"
    echo "RELEASE_ROLLOUT=$(state_value RELEASE_ROLLOUT "$ROLLOUT_STATE")"
    echo "AUTO_APPLY_ALLOWED=$(state_value AUTO_APPLY_ALLOWED "$ROLLOUT_STATE")"
    echo "AUTO_APPLY_STATE=$(state_value AUTO_APPLY_STATE "$ROLLOUT_STATE")"
    echo "ROLLOUT_POLICY_STATUS=$(state_value POLICY_STATUS "$ROLLOUT_STATE")"
    echo "FAILOVER_VERSION=$(state_value INSTALLED_VERSION "$FAILOVER_CONF")"
    echo "MONITORING_VERSION=1.7.0"
    echo "SYSTEM=$(uptime 2>/dev/null || echo unknown)"
    echo "HOSTNAME=$(hostname)"
    vpn=$(health_value ACTIVE_VPN)
    case "$vpn" in awg_main|awg_backup)
        vpn_age=$(awg_handshake_age "$vpn")
        case "$vpn_age" in ''|*[!0-9]*) vpn_status=UNKNOWN ;; *)
            if [ "$vpn_age" -le 180 ]; then
                [ "$vpn" != awg_backup ] && vpn_status=Connected || vpn_status='Failover active'
            else vpn_status=UNAVAILABLE; fi ;;
        esac ;;
        *) vpn_status=UNKNOWN ;;
    esac
    echo "VPN_STATUS=$vpn_status"
    [ "$vpn" != awg_backup ] && echo 'BACKUP_TUNNEL_STATUS=Standby' || echo 'BACKUP_TUNNEL_STATUS=Failover active'
    echo "LAST_ERROR=$(health_value REASON)"
    echo "PODKOP_VERSION=$(podkop show_version 2>/dev/null || echo unknown)"
    if [ -f /tmp/sing-box/cache.db ]; then echo "FAKEIP_CACHE_SIZE=$(wc -c < /tmp/sing-box/cache.db) bytes"; else echo 'FAKEIP_CACHE_SIZE=unknown'; fi
    echo "FAKEIP_LAST_ERROR=$(health_value FAKEIP_ERROR)"
    echo "FAKEIP_ERROR_TYPE=$(health_value FAKEIP_ERROR_TYPE)"
    echo "PROBLEM_COUNT=$(wc -l < "$PROBLEM_LOG" 2>/dev/null || echo 0)"
}

problems_cmd() {
    lines="${1:-100}"
    case "$lines" in ''|*[!0-9]*) lines=100 ;; esac
    tail -n "$lines" "$PROBLEM_LOG" 2>/dev/null
}

events_cmd() {
    lines="${1:-100}"
    case "$lines" in ''|*[!0-9]*) lines=100 ;; esac
    logread 2>/dev/null | grep -E 'podkop-awg|podkop-service-health|HOME NET' | tail -n "$lines"
}

healthlog_cmd() {
    lines="${1:-100}"
    case "$lines" in ''|*[!0-9]*) lines=100 ;; esac
    latest="$(ls -1 "$HEALTH_DIR"/service-*.log 2>/dev/null | tail -n 1)"
    [ -n "$latest" ] && tail -n "$lines" "$latest"
}


settings_cmd() {
    configured=$(update_local_value HOME_NET_AUTO_UPDATE_ENABLED)
    [ -z "$configured" ] && echo 'LOCAL_POLICY_CONFIGURED=0' || echo 'LOCAL_POLICY_CONFIGURED=1'
    for key in HOME_NET_AUTO_UPDATE_ENABLED HOME_NET_UPDATE_MODE HOME_NET_UPDATE_TIME HOME_NET_UPDATE_WINDOW_START HOME_NET_UPDATE_WINDOW_END HOME_NET_UPDATE_JITTER; do
        printf '%s=%s\n' "$key" "$(update_local_value "$key")"
    done
}
logs_cmd() {
    component="${1:-all}" severity="${2:-all}" lines="${3:-100}"
    case "$component" in all|updater|monitoring|failover|podkop|sing-box|system) ;; *) exit 2 ;; esac
    case "$severity" in all|info|warning|error) ;; *) exit 2 ;; esac
    case "$lines" in 50|100|250|500) ;; *) exit 2 ;; esac
    # Bounded newest input; filter before limiting displayed rows.
    logread 2>/dev/null | tail -n 3000 | awk -v c="$component" -v s="$severity" '
        { l=tolower($0); match_component=(c=="all" || (c=="system" && l !~ /home-net|podkop|sing-box/) ||
          (c=="updater" && l ~ /home-net-update/) || (c=="monitoring" && l ~ /podkop-service-health|home-net-log/) ||
          (c=="failover" && l ~ /podkop-awg/) || (c=="podkop" && l ~ /podkop/) || (c=="sing-box" && l ~ /sing-box/));
          level=(l ~ /err(or)?|fail/ ? "error" : (l ~ /warn/ ? "warning" : "info"));
          if (match_component && (s=="all" || s==level)) print }' | tail -n "$lines" |
        sed -E 's/(password|token|private_key|preshared_key|secret)[=:][^[:space:]]+/\1=[redacted]/g'
}

case "${1:-status}" in
    status) status_cmd ;;
    settings) settings_cmd ;;
    logs) shift; logs_cmd "${1:-all}" "${2:-all}" "${3:-100}" ;;
    problems) shift; problems_cmd "${1:-100}" ;;
    events) shift; events_cmd "${1:-100}" ;;
    healthlog) shift; healthlog_cmd "${1:-100}" ;;
    *) echo "Usage: $0 {status|problems [N]|events [N]|healthlog [N]}" >&2; exit 2 ;;
esac
