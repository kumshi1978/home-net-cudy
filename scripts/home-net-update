#!/bin/sh

# Stable-release updater for the complete HOME NET bundle.
CONF=${HOME_NET_UPDATE_CONF:-/etc/home-net-update.conf}
INSTALLED_STATE=${HOME_NET_UPDATE_STATE_FILE:-/etc/home-net-update.state}
RUNTIME_DIR=${HOME_NET_UPDATE_RUNTIME_DIR:-/tmp/home-net-update}
LOCK_DIR=${HOME_NET_UPDATE_LOCK_DIR:-/var/run/home-net-update.lock}
HEALTH_STATE=${HOME_NET_UPDATE_HEALTH_STATE:-/tmp/podkop-service-health/state}
BACKUP_ROOT=${HOME_NET_UPDATE_BACKUP_ROOT:-/root}
UPDATED_MARKER="$RUNTIME_DIR/updated"
COORDINATION_MARKER=${HOME_NET_UPDATE_COORDINATION_MARKER:-/var/run/home-net-update.in-progress}
BOOT_ID_FILE=${HOME_NET_UPDATE_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}
TAG=home-net-update
REPO=${HOME_NET_UPDATE_REPO:-kumshi1978/home-net-cudy}
API_URL=${HOME_NET_UPDATE_API_URL:-https://api.github.com/repos/$REPO/releases/latest}
RAW_URL=${HOME_NET_UPDATE_RAW_URL:-https://raw.githubusercontent.com/$REPO}

# Offline self-test must never execute the operator's configuration.
if [ "${1:-}" != self-test ]; then
    [ -r "$CONF" ] && . "$CONF"
fi

MODE=${HOME_NET_UPDATE_MODE:-check}
CANARY=${HOME_NET_UPDATE_CANARY:-0}

# New rollout model. If both new keys are absent, keep legacy semantics exactly.
ROLLOUT_MODEL=1
if [ -z "${HOME_NET_AUTO_UPDATE_CAPABLE+x}" ] && [ -z "${HOME_NET_ROLLOUT_RING+x}" ]; then
    ROLLOUT_MODEL=0
fi
if [ "$ROLLOUT_MODEL" = "1" ]; then
    AUTO_UPDATE_CAPABLE=${HOME_NET_AUTO_UPDATE_CAPABLE:-0}
    ROLLOUT_RING=${HOME_NET_ROLLOUT_RING:-stable}
else
    [ "$MODE" = "apply" ] && AUTO_UPDATE_CAPABLE=1 || AUTO_UPDATE_CAPABLE=0
    [ "$CANARY" = "1" ] && ROLLOUT_RING=canary || ROLLOUT_RING=stable
fi
ROLLOUT_POLICY_URL=${HOME_NET_ROLLOUT_POLICY_URL:-https://raw.githubusercontent.com/$REPO/main/rollout-policy.conf}
ROLLOUT_CACHE="$RUNTIME_DIR/rollout.state"
POLICY_STATUS=UNKNOWN
RELEASE_ROLLOUT=unknown
AUTO_APPLY_ALLOWED=0
AUTO_APPLY_STATE='POLICY UNKNOWN'

INTERVAL=${HOME_NET_UPDATE_INTERVAL:-86400}
JITTER=${HOME_NET_UPDATE_JITTER:-21600}
STARTUP_DELAY=${HOME_NET_UPDATE_STARTUP_DELAY:-300}
COMMAND_TIMEOUT=${HOME_NET_UPDATE_COMMAND_TIMEOUT:-120}
HEALTH_TIMEOUT=${HOME_NET_UPDATE_HEALTH_TIMEOUT:-600}
HEALTH_RETRY_INTERVAL=${HOME_NET_UPDATE_HEALTH_RETRY_INTERVAL:-10}
HEALTH_MAX_BAD_CYCLES=${HOME_NET_UPDATE_HEALTH_MAX_BAD_CYCLES:-3}
UPDATED=0
COORDINATION_ACTIVE=0
PODKOP_HEALTH_STOPPED=0
LAST_HEALTH_RESULT=UNKNOWN

log() { logger -t "$TAG" "$*" 2>/dev/null || true; printf '%s\n' "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

bounded_run() {
    limit="$1"
    shift
    "$@" &
    cmd_pid=$!
    elapsed=0
    while kill -0 "$cmd_pid" 2>/dev/null; do
        if [ "$elapsed" -ge "$limit" ]; then
            kill "$cmd_pid" 2>/dev/null || true
            sleep 1
            kill -9 "$cmd_pid" 2>/dev/null || true
            wait "$cmd_pid" 2>/dev/null || true
            return 124
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    wait "$cmd_pid"
}

release_lock() {
    if [ "$PODKOP_HEALTH_STOPPED" = "1" ] && [ -x /etc/init.d/podkop-health ]; then
        /etc/init.d/podkop-health start >/dev/null 2>&1 || true
        PODKOP_HEALTH_STOPPED=0
    fi
    if [ "$COORDINATION_ACTIVE" = "1" ]; then
        rm -f "$COORDINATION_MARKER"
        COORDINATION_ACTIVE=0
    fi
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
    trap - EXIT INT TERM
}

acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" > "$LOCK_DIR/pid"
        trap release_lock EXIT INT TERM
        return 0
    fi

    lock_pid=""
    [ -r "$LOCK_DIR/pid" ] && read lock_pid < "$LOCK_DIR/pid"
    if [ -z "$lock_pid" ] || ! kill -0 "$lock_pid" 2>/dev/null; then
        log "recovering stale update lock"
        rm -f "$LOCK_DIR/pid"
        rmdir "$LOCK_DIR" 2>/dev/null || true
        mkdir "$LOCK_DIR" 2>/dev/null || return 1
        printf '%s\n' "$$" > "$LOCK_DIR/pid"
        trap release_lock EXIT INT TERM
        return 0
    fi
    return 1
}

valid_version() {
    printf '%s\n' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
}

valid_uint() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}

version_gt() {
    version_a="$1"
    version_b="$2"
    old_ifs="$IFS"
    IFS=.
    set -- $version_a
    a1=$1 a2=$2 a3=$3
    set -- $version_b
    b1=$1 b2=$2 b3=$3
    IFS="$old_ifs"
    [ "$a1" -gt "$b1" ] && return 0
    [ "$a1" -lt "$b1" ] && return 1
    [ "$a2" -gt "$b2" ] && return 0
    [ "$a2" -lt "$b2" ] && return 1
    [ "$a3" -gt "$b3" ]
}

state_value() {
    key="$1"
    file="$2"
    [ -r "$file" ] || return 0
    sed -n "s/^${key}=//p" "$file" | tail -n 1 | sed "s/^'//; s/'$//"
}

installed_version() {
    current="$(state_value INSTALLED_VERSION "$INSTALLED_STATE")"
    [ -n "$current" ] || current="$(state_value INSTALLED_BUNDLE_VERSION "$INSTALLED_STATE")"
    [ -n "$current" ] || current=0.0.0
    valid_version "$current" || die "invalid installed bundle version: $current"
}

active_version() {
    active="$(state_value ACTIVE_VERSION "$INSTALLED_STATE")"
    [ -n "$active" ] || active="$current"
    valid_version "$active" || die "invalid active bundle version: $active"
}

fetch_release() {
    mkdir -p "$RUNTIME_DIR"
    release_json="$RUNTIME_DIR/release.json"
    bounded_run "$COMMAND_TIMEOUT" curl -4 -fsSL \
        --connect-timeout 10 --max-time "$COMMAND_TIMEOUT" \
        -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' \
        "$API_URL" -o "$release_json" || die "cannot fetch stable release metadata"

    compact="$(tr -d '\r\n' < "$release_json")"
    printf '%s\n' "$compact" | grep -Eq '"draft"[[:space:]]*:[[:space:]]*false' || die "latest release is draft or metadata is invalid"
    printf '%s\n' "$compact" | grep -Eq '"prerelease"[[:space:]]*:[[:space:]]*false' || die "latest release is prerelease or metadata is invalid"
    release_tag="$(printf '%s\n' "$compact" | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\(v[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)".*/\1/p')"
    [ -n "$release_tag" ] || die "stable release tag is missing or invalid"
    release_version=${release_tag#v}
    valid_version "$release_version" || die "invalid stable release version: $release_version"
}

check_release() {
    fetch_release
    installed_version
    if version_gt "$release_version" "$current"; then
        log "stable HOME NET update available: $current -> $release_version ($release_tag)"
        return 10
    fi
    if version_gt "$current" "$release_version"; then
        log "installed HOME NET bundle $current is newer than latest stable $release_version; no downgrade"
    else
        log "installed HOME NET bundle $current is the latest stable release"
    fi
    return 0
}


write_rollout_cache() {
    mkdir -p "$RUNTIME_DIR"
    cache_tmp="$ROLLOUT_CACHE.tmp.$$"
    {
        printf "LATEST_RELEASE='%s'\n" "${release_tag:-unknown}"
        printf "RELEASE_ROLLOUT='%s'\n" "$RELEASE_ROLLOUT"
        printf "POLICY_STATUS='%s'\n" "$POLICY_STATUS"
        printf "AUTO_APPLY_ALLOWED='%s'\n" "$AUTO_APPLY_ALLOWED"
        printf "AUTO_APPLY_STATE='%s'\n" "$AUTO_APPLY_STATE"
        printf "ROLLOUT_RING='%s'\n" "$ROLLOUT_RING"
        printf "AUTO_UPDATE_CAPABLE='%s'\n" "$AUTO_UPDATE_CAPABLE"
        printf "CHECKED_AT='%s'\n" "$(date '+%F %T')"
    } > "$cache_tmp"
    chmod 0600 "$cache_tmp"
    mv "$cache_tmp" "$ROLLOUT_CACHE"
}

set_rollout_wait_state() {
    AUTO_APPLY_ALLOWED=0
    case "$RELEASE_ROLLOUT" in
        manual) AUTO_APPLY_STATE='WAITING FOR CANARY' ;;
        canary)
            if [ "$ROLLOUT_RING" = "canary" ]; then
                AUTO_APPLY_STATE='AUTO APPLY ALLOWED'
                AUTO_APPLY_ALLOWED=1
            else
                AUTO_APPLY_STATE='WAITING FOR FLEET'
            fi
            ;;
        fleet)
            AUTO_APPLY_STATE='AUTO APPLY ALLOWED'
            AUTO_APPLY_ALLOWED=1
            ;;
        *) AUTO_APPLY_STATE='POLICY BLOCKED' ;;
    esac
    if [ "$AUTO_UPDATE_CAPABLE" != "1" ]; then
        AUTO_APPLY_ALLOWED=0
        AUTO_APPLY_STATE='AUTO UPDATE DISABLED'
    fi
}

evaluate_rollout_policy() {
    # Input: policy_file, release_tag, ROLLOUT_RING, AUTO_UPDATE_CAPABLE.
    # Output only: rollout decision variables. No downloads or state writes.
    POLICY_STATUS=INVALID
    RELEASE_ROLLOUT=unknown
    AUTO_APPLY_ALLOWED=0
    AUTO_APPLY_STATE='POLICY BLOCKED'
    if grep -Ev '^[[:space:]]*(#.*)?$|^(POLICY_SCHEMA|RELEASE_TAG|ROLLOUT)=' "$policy_file" | grep -q .; then
        return 1
    fi
    policy_schema="$(sed -n "s/^POLICY_SCHEMA='\([^']*\)'$/\1/p" "$policy_file" | tail -n 1)"
    policy_tag="$(sed -n "s/^RELEASE_TAG='\([^']*\)'$/\1/p" "$policy_file" | tail -n 1)"
    policy_rollout="$(sed -n "s/^ROLLOUT='\([^']*\)'$/\1/p" "$policy_file" | tail -n 1)"
    [ "$policy_schema" = 1 ] || return 1
    case "$policy_rollout" in manual|canary|fleet) ;; *) return 1 ;; esac
    RELEASE_ROLLOUT="$policy_rollout"
    if [ "$policy_tag" != "$release_tag" ]; then
        POLICY_STATUS=MISMATCH
        return 1
    fi
    POLICY_STATUS=OK
    set_rollout_wait_state
}

fetch_rollout_policy() {
    policy_file="$RUNTIME_DIR/rollout-policy.conf"
    POLICY_STATUS=UNAVAILABLE
    RELEASE_ROLLOUT=unknown
    AUTO_APPLY_ALLOWED=0
    AUTO_APPLY_STATE='POLICY BLOCKED'

    if ! bounded_run "$COMMAND_TIMEOUT" curl -4 -fsSL \
        --connect-timeout 10 --max-time "$COMMAND_TIMEOUT" \
        "$ROLLOUT_POLICY_URL" -o "$policy_file"; then
        write_rollout_cache
        log "rollout policy unavailable; automatic apply denied"
        return 1
    fi

    if ! evaluate_rollout_policy; then
        write_rollout_cache
        log "rollout policy $POLICY_STATUS; automatic apply denied"
        return 1
    fi
    write_rollout_cache
    return 0
}

automatic_release() {
    fetch_release
    installed_version

    if ! version_gt "$release_version" "$current"; then
        fetch_rollout_policy || true
        if version_gt "$current" "$release_version"; then
            log "installed HOME NET bundle $current is newer than latest stable $release_version; no downgrade"
        else
            log "installed HOME NET bundle $current is the latest stable release"
        fi
        return 0
    fi

    log "stable HOME NET update available: $current -> $release_version ($release_tag)"
    active_version
    fetch_rollout_policy || {
        record_update_available
        return 0
    }

    if [ "$AUTO_APPLY_ALLOWED" != "1" ]; then
        record_update_available
        log "automatic apply not allowed: ring=$ROLLOUT_RING capable=$AUTO_UPDATE_CAPABLE rollout=$RELEASE_ROLLOUT state=$AUTO_APPLY_STATE"
        return 0
    fi

    log "automatic apply allowed: ring=$ROLLOUT_RING rollout=$RELEASE_ROLLOUT"
    apply_fetched_release
}

reject_disruptive_actions() {
    payload="$1"
    label="$2"
    # This is intentionally a small lexical guard for our own release scripts,
    # not a general shell parser. Ignore comments and quoted diagnostic text,
    # then require a disruptive command to appear in command position.
    if awk '
        BEGIN { quote = "" }
        {
            output = ""
            escaped = 0
            for (i = 1; i <= length($0); i++) {
                char = substr($0, i, 1)
                previous = (i > 1) ? substr($0, i - 1, 1) : ""

                if (quote == "single") {
                    if (char == sprintf("%c", 39)) quote = ""
                    continue
                }
                if (quote == "double") {
                    if (escaped) { escaped = 0; continue }
                    if (char == "\\") { escaped = 1; continue }
                    if (char == "\"") quote = ""
                    continue
                }

                if (char == "#" && (i == 1 || previous ~ /[[:space:];&|()]/)) break
                if (char == sprintf("%c", 39)) { quote = "single"; output = output " "; continue }
                if (char == "\"") { quote = "double"; output = output " "; continue }
                output = output char
            }
            print output
        }
    ' "$payload" | grep -Eq '(^|[;&|][;&|]?)[[:space:]]*((/etc/init\.d/network|service[[:space:]]+network)[[:space:]]+(restart|reload)([[:space:];&|]|$)|reboot([[:space:];&|]|$)|ubus[[:space:]]+call[[:space:]]+system[[:space:]]+reboot([[:space:];&|]|$)|shutdown[[:space:]].*-r([[:space:];&|]|$))'; then
        die "$label contains an automatic network restart or reboot"
    fi
}

download_release_payload() {
    work="$RUNTIME_DIR/$release_tag"
    mkdir -p "$work"
    version_file="$work/VERSION"
    bundle_file="$work/bundle.conf"
    installer="$work/install-all.sh"

    for payload in VERSION bundle.conf install-all.sh; do
        bounded_run "$COMMAND_TIMEOUT" curl -4 -fsSL \
            --connect-timeout 10 --max-time "$COMMAND_TIMEOUT" \
            "$RAW_URL/$release_tag/$payload" -o "$work/$payload" \
            || die "cannot download $payload from $release_tag"
    done

    downloaded_version="$(tr -d '\r\n' < "$version_file")"
    [ "$downloaded_version" = "$release_version" ] || die "release VERSION does not match tag"
    grep -Fq "HOME_NET_BUNDLE_VERSION='$release_version'" "$bundle_file" || die "bundle.conf version does not match release"
    sh -n "$installer" || die "downloaded install-all.sh failed syntax validation"

    reject_disruptive_actions "$installer" "install-all.sh"

    UPDATE_ACTION_CLASS="$(sed -n "s/^UPDATE_ACTION_CLASS='\([^']*\)'$/\1/p" "$bundle_file" | tail -n 1)"
    UPDATE_PENDING_ACTION="$(sed -n "s/^UPDATE_PENDING_ACTION='\([^']*\)'$/\1/p" "$bundle_file" | tail -n 1)"
    UPDATE_PENDING_REASON="$(sed -n "s/^UPDATE_PENDING_REASON='\([^']*\)'$/\1/p" "$bundle_file" | tail -n 1)"
    [ -n "$UPDATE_PENDING_ACTION" ] || UPDATE_PENDING_ACTION=none
    plan_update_action || die "$action_plan_error"
}

plan_update_action() {
    # Shared activation decision; deliberately has no runtime side effects.
    stage_only=0
    controlled_action=0
    activation_status=OK
    activation_version="$release_version"
    action_plan_error='invalid or missing UPDATE_ACTION_CLASS'
    case "$UPDATE_ACTION_CLASS" in
        SAFE) ;;
        CONTROLLED) controlled_action=1 ;;
        CRITICAL)
            action_plan_error='CRITICAL release must declare UPDATE_PENDING_ACTION'
            [ -n "$UPDATE_PENDING_ACTION" ] && [ "$UPDATE_PENDING_ACTION" != none ] || return 1
            stage_only=1
            activation_status=PENDING_APPLY
            activation_version="$active"
            ;;
        *) return 1 ;;
    esac
}

create_backup() {
    backup="$BACKUP_ROOT/home-net-update-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$backup"
    cp -p "$release_json" "$version_file" "$bundle_file" "$installer" "$backup/"
    [ -r "$CONF" ] && cp -p "$CONF" "$backup/home-net-update.conf"
    [ -r "$INSTALLED_STATE" ] && cp -p "$INSTALLED_STATE" "$backup/home-net-update.state"
    {
        printf "FROM_VERSION='%s'\n" "$current"
        printf "TARGET_VERSION='%s'\n" "$release_version"
        printf "TARGET_TAG='%s'\n" "$release_tag"
        printf "STARTED_AT='%s'\n" "$(date '+%F %T')"
    } > "$backup/install-metadata"
    log "pre-apply backup created: $backup"
}

health_value() {
    key="$1"
    [ -r "$HEALTH_STATE" ] || return 0
    sed -n "s/^${key}=//p" "$HEALTH_STATE" | tail -n 1
}

evaluate_health() {
    health_status="$(health_value STATUS)"
    LAST_HEALTH_RESULT="$health_status"
    [ "$health_status" = "OK" ] || {
        [ "$health_status" = "UNKNOWN" ] || LAST_HEALTH_RESULT=FAIL
        return 1
    }

    for required in \
        PODKOP=RUNNING \
        SING_BOX=RUNNING \
        FAKEIP=OK \
        SERVICE_CHECK=OK
    do
        key=${required%%=*}
        expected=${required#*=}
        actual="$(health_value "$key")"
        if [ "$actual" != "$expected" ]; then
            LAST_HEALTH_RESULT=FAIL
            return 1
        fi
    done
    LAST_HEALTH_RESULT=OK
    return 0
}

wait_for_healthy_cycle() {
    before_last="$1"
    before_started="$2"
    elapsed=0
    bad_cycles=0
    seen_last="$before_last"

    while [ "$elapsed" -lt "$HEALTH_TIMEOUT" ]; do
        last_check="$(health_value LAST_CHECK)"
        check_started="$(health_value CHECK_STARTED)"
        fresh=0
        [ -n "$last_check" ] && [ "$last_check" != "$seen_last" ] && fresh=1
        if [ "$fresh" -eq 0 ] && [ -n "$last_check" ] && \
           [ "$check_started" != "$before_started" ] && [ "$last_check" = "$check_started" ]; then
            fresh=1
        fi

        if [ "$fresh" -eq 1 ]; then
            seen_last="$last_check"
            before_started="$check_started"
            if evaluate_health; then
                log "post-update Monitoring cycle is healthy"
                return 0
            fi
            bad_cycles=$((bad_cycles + 1))
            log "post-update health is $LAST_HEALTH_RESULT ($bad_cycles/$HEALTH_MAX_BAD_CYCLES)"
            [ "$bad_cycles" -lt "$HEALTH_MAX_BAD_CYCLES" ] || return 1
        fi

        sleep "$HEALTH_RETRY_INTERVAL"
        elapsed=$((elapsed + HEALTH_RETRY_INTERVAL))
    done

    log "post-update health timed out after ${HEALTH_TIMEOUT}s"
    [ "$bad_cycles" -gt 0 ] || LAST_HEALTH_RESULT=UNKNOWN
    return 1
}

clean_state_value() {
    printf '%s' "$1" | tr -d "\r\n'"
}

write_update_state() {
    new_installed="$(clean_state_value "$1")"
    new_active="$(clean_state_value "$2")"
    new_status="$(clean_state_value "$3")"
    new_pending_action="$(clean_state_value "$4")"
    new_pending_reason="$(clean_state_value "$5")"
    new_pending_version="$(clean_state_value "$6")"
    new_health="$(clean_state_value "$7")"
    new_pending_boot="$(clean_state_value "${8:-none}")"
    state_dir=${INSTALLED_STATE%/*}
    [ "$state_dir" = "$INSTALLED_STATE" ] || mkdir -p "$state_dir"
    state_tmp="$INSTALLED_STATE.tmp.$$"
    {
        printf "INSTALLED_VERSION='%s'\n" "$new_installed"
        printf "ACTIVE_VERSION='%s'\n" "$new_active"
        printf "UPDATE_STATUS='%s'\n" "$new_status"
        printf "PENDING_ACTION='%s'\n" "$new_pending_action"
        printf "PENDING_REASON='%s'\n" "$new_pending_reason"
        printf "PENDING_VERSION='%s'\n" "$new_pending_version"
        printf "PENDING_BOOT_ID='%s'\n" "$new_pending_boot"
        printf "LAST_UPDATE='%s'\n" "$(date '+%F %T')"
        printf "LAST_HEALTH_STATUS='%s'\n" "$new_health"
        printf "INSTALL_SOURCE='stable-release'\n"
    } > "$state_tmp"
    chmod 0600 "$state_tmp"
    mv "$state_tmp" "$INSTALLED_STATE"
}

current_boot_id() {
    if [ -r "$BOOT_ID_FILE" ]; then
        read boot_id < "$BOOT_ID_FILE"
        printf '%s' "$boot_id"
    else
        printf 'unknown'
    fi
}

begin_controlled_action() {
    [ -r "$LOCK_DIR/pid" ] || die "update lock is not held"
    ip -4 route show default 2>/dev/null | grep -q '^default ' || die "CONTROLLED preflight failed: no IPv4 default route"
    active_vpn="$(uci -q get podkop.main.interface 2>/dev/null || true)"
    [ -n "$active_vpn" ] && [ "$active_vpn" != "unknown" ] || die "CONTROLLED preflight failed: active VPN is unknown"
    [ ! -e /var/run/podkop-recovery.lock ] || die "CONTROLLED preflight failed: Podkop recovery is active"
    evaluate_health || die "CONTROLLED preflight failed: health is $LAST_HEALTH_RESULT"

    marker_dir=${COORDINATION_MARKER%/*}
    [ "$marker_dir" = "$COORDINATION_MARKER" ] || mkdir -p "$marker_dir"
    {
        printf "PID='%s'\n" "$$"
        printf "VERSION='%s'\n" "$release_version"
        printf "CLASS='CONTROLLED'\n"
    } > "$COORDINATION_MARKER"
    COORDINATION_ACTIVE=1

    if [ -x /etc/init.d/podkop-health ]; then
        /etc/init.d/podkop-health stop >/dev/null 2>&1 || die "cannot pause podkop-health for CONTROLLED action"
        PODKOP_HEALTH_STOPPED=1
    fi
    log "CONTROLLED preflight passed; recovery coordination marker created"
}

resume_controlled_recovery() {
    if [ "$PODKOP_HEALTH_STOPPED" = "1" ] && [ -x /etc/init.d/podkop-health ]; then
        /etc/init.d/podkop-health start >/dev/null 2>&1 || true
        PODKOP_HEALTH_STOPPED=0
    fi
}

record_update_available() {
    installed_version
    active_version
    existing_status="$(state_value UPDATE_STATUS "$INSTALLED_STATE")"
    case "$existing_status" in PENDING_APPLY|INSTALLING|VERIFYING|FAILED) return 0 ;; esac
    evaluate_health || true
    write_update_state "$current" "$active" UPDATE_AVAILABLE none \
        "stable release $release_version is available" "$release_version" "$LAST_HEALTH_RESULT" none
}

reconcile_pending_reboot() {
    pending_status="$(state_value UPDATE_STATUS "$INSTALLED_STATE")"
    pending_action="$(state_value PENDING_ACTION "$INSTALLED_STATE")"
    [ "$pending_status" = "PENDING_APPLY" ] && [ "$pending_action" = "reboot" ] || return 0

    installed_version
    active_version
    pending_boot="$(state_value PENDING_BOOT_ID "$INSTALLED_STATE")"
    boot_now="$(current_boot_id)"
    [ -n "$pending_boot" ] && [ "$pending_boot" != "none" ] && \
        [ "$pending_boot" != "unknown" ] && [ "$boot_now" != "$pending_boot" ] || return 0

    if evaluate_health; then
        write_update_state "$current" "$current" OK none none none OK none
        log "pending reboot completed; active HOME NET version promoted to $current"
    else
        log "pending reboot detected, but health is $LAST_HEALTH_RESULT; activation remains pending"
    fi
}

show_status() {
    installed="$(state_value INSTALLED_VERSION "$INSTALLED_STATE")"
    [ -n "$installed" ] || installed="$(state_value INSTALLED_BUNDLE_VERSION "$INSTALLED_STATE")"
    [ -n "$installed" ] || installed=0.0.0
    active_state="$(state_value ACTIVE_VERSION "$INSTALLED_STATE")"
    [ -n "$active_state" ] || active_state="$installed"
    update_state="$(state_value UPDATE_STATUS "$INSTALLED_STATE")"
    [ -n "$update_state" ] || update_state=OK
    pending_state="$(state_value PENDING_ACTION "$INSTALLED_STATE")"
    [ -n "$pending_state" ] || pending_state=none
    health_state="$(state_value LAST_HEALTH_STATUS "$INSTALLED_STATE")"
    [ -n "$health_state" ] || health_state=UNKNOWN

    printf '%s\n' 'HOME NET updater'
    printf 'Installed: %s\n' "$installed"
    printf 'Active:    %s\n' "$active_state"
    printf 'Status:    %s\n' "$update_state"
    printf 'Pending:   %s\n' "$pending_state"
    printf 'Health:    %s\n' "$health_state"
    printf 'Ring:      %s\n' "$ROLLOUT_RING"
    printf 'Capable:   %s\n' "$AUTO_UPDATE_CAPABLE"
    if [ -r "$ROLLOUT_CACHE" ]; then
        printf 'Latest:    %s\n' "$(state_value LATEST_RELEASE "$ROLLOUT_CACHE")"
        printf 'Rollout:   %s\n' "$(state_value RELEASE_ROLLOUT "$ROLLOUT_CACHE")"
        printf 'AutoApply: %s\n' "$(state_value AUTO_APPLY_ALLOWED "$ROLLOUT_CACHE")"
        printf 'Gate:      %s\n' "$(state_value AUTO_APPLY_STATE "$ROLLOUT_CACHE")"
        printf 'Policy:    %s\n' "$(state_value POLICY_STATUS "$ROLLOUT_CACHE")"
    else
        printf 'Latest:    unknown\n'
        printf 'Rollout:   unknown\n'
        printf 'AutoApply: 0\n'
        printf 'Gate:      POLICY UNKNOWN\n'
        printf 'Policy:    UNKNOWN\n'
    fi
}

apply_fetched_release() {
    download_release_payload
    create_backup
    before_last="$(health_value LAST_CHECK)"
    before_started="$(health_value CHECK_STARTED)"

    plan_update_action || die "invalid update action plan"
    [ "$controlled_action" != 1 ] || begin_controlled_action
    [ "$stage_only" != 1 ] || log "CRITICAL activation will be staged as PENDING_APPLY"

    evaluate_health || true
    write_update_state "$current" "$active" INSTALLING none \
        "installing $release_tag ($UPDATE_ACTION_CLASS)" "$release_version" "$LAST_HEALTH_RESULT" none

    log "installing stable HOME NET bundle $release_tag class=$UPDATE_ACTION_CLASS"
    if ! HOME_NET_BUNDLE_REF="$release_tag" \
         HOME_NET_UPDATE_IN_PROGRESS=1 \
         HOME_NET_SKIP_VERSION_RECORD=1 \
         HOME_NET_ACTION_CLASS="$UPDATE_ACTION_CLASS" \
         HOME_NET_STAGE_ONLY="$stage_only" \
         sh "$installer"
    then
        resume_controlled_recovery
        evaluate_health || true
        write_update_state "$current" "$active" FAILED none \
            "bundle installer failed" "$release_version" "$LAST_HEALTH_RESULT" none
        die "bundle installer failed; installed version was not changed; backup: $backup"
    fi

    resume_controlled_recovery
    write_update_state "$release_version" "$active" VERIFYING none \
        "waiting for post-update health" "$release_version" UNKNOWN none
    if ! wait_for_healthy_cycle "$before_last" "$before_started"; then
        write_update_state "$release_version" "$active" FAILED verification \
            "post-update health did not become OK" "$release_version" "$LAST_HEALTH_RESULT" none
        die "bundle installed but activation health failed; active version was not changed; backup: $backup"
    fi

    if [ "$activation_status" = "PENDING_APPLY" ]; then
        pending_boot=none
        [ "$UPDATE_PENDING_ACTION" = "reboot" ] && pending_boot="$(current_boot_id)"
        write_update_state "$release_version" "$activation_version" "$activation_status" \
            "$UPDATE_PENDING_ACTION" "$UPDATE_PENDING_REASON" "$release_version" OK "$pending_boot"
        UPDATED=1
        : > "$UPDATED_MARKER"
        log "bundle $release_tag installed; CRITICAL action $UPDATE_PENDING_ACTION remains pending"
        return 0
    fi

    write_update_state "$release_version" "$activation_version" "$activation_status" none none none OK none
    UPDATED=1
    : > "$UPDATED_MARKER"
    log "stable HOME NET bundle $release_tag applied and recorded successfully"
}

apply_release() {
    if [ "$ROLLOUT_MODEL" = "0" ]; then
        [ "$MODE" = "apply" ] || die "apply is allowed only when HOME_NET_UPDATE_MODE='apply'"
        [ "$CANARY" = "1" ] || die "apply is allowed only when HOME_NET_UPDATE_CANARY='1'"
    fi

    check_release
    check_rc=$?
    [ "$check_rc" -eq 10 ] || return "$check_rc"
    active_version
    log "manual apply requested; rollout policy does not override explicit operator action"
    apply_fetched_release
}

cohort_delay() {
    case "$JITTER" in ''|*[!0-9]*) printf '0'; return ;; esac
    [ "$JITTER" -gt 0 ] || { printf '0'; return; }

    if [ -r /etc/machine-id ]; then
        read seed < /etc/machine-id
        prefix="$(printf '%.8s' "$seed")"
        case "$prefix" in ''|*[!0-9A-Fa-f]*) prefix='' ;; esac
        if [ -n "$prefix" ]; then
            number=$((0x$prefix))
            printf '%s' "$((number % JITTER))"
            return
        fi
    fi

    if [ -r /sys/class/net/eth0/address ]; then
        read mac < /sys/class/net/eth0/address
        old_ifs="$IFS"
        IFS=:
        set -- $mac
        IFS="$old_ifs"
        if [ "$#" -ge 4 ]; then
            prefix="$1$2$3$4"
            case "$prefix" in ''|*[!0-9A-Fa-f]*) prefix='' ;; esac
            if [ -n "$prefix" ]; then
                number=$((0x$prefix))
                printf '%s' "$((number % JITTER))"
                return
            fi
        fi
    fi

    printf '0'
}

run_once() {
    acquire_lock || { log "another HOME NET update is already running; skipped"; return 0; }
    case "$1" in
        check)
            check_release
            rc=$?
            if [ "$ROLLOUT_MODEL" = "1" ]; then
                fetch_rollout_policy || true
            fi
            if [ "$rc" -eq 10 ]; then
                record_update_available
                rc=0
            fi
            ;;
        apply) apply_release; rc=$? ;;
        auto) automatic_release; rc=$? ;;
        reconcile) reconcile_pending_reboot; rc=$? ;;
        *) rc=2 ;;
    esac
    release_lock
    return "$rc"
}

daemon() {
    case "$MODE" in check|apply) ;; *) die "HOME_NET_UPDATE_MODE must be check or apply" ;; esac
    if [ "$ROLLOUT_MODEL" = "0" ]; then
        [ "$MODE" != "apply" ] || [ "$CANARY" = "1" ] || die "daemon apply mode requires HOME_NET_UPDATE_CANARY='1'"
        daemon_action="$MODE"
        log_mode="legacy mode=$MODE canary=$CANARY"
    else
        daemon_action=auto
        log_mode="ring=$ROLLOUT_RING capable=$AUTO_UPDATE_CAPABLE"
    fi

    sleep "$STARTUP_DELAY"
    "$0" reconcile || true
    delay="$(cohort_delay)"
    log "automatic HOME NET $log_mode fleet_delay=${delay}s interval=${INTERVAL}s"
    sleep "$delay"
    while true; do
        rm -f "$UPDATED_MARKER"
        if ! "$0" "$daemon_action"; then
            log "automatic HOME NET $daemon_action run failed; next attempt follows the normal interval"
        fi
        [ -f "$UPDATED_MARKER" ] && exit 0
        sleep "$INTERVAL"
    done
}

self_test() (
    # Subshell and private fixtures isolate every decision from real router state.
    test_dir="$(mktemp -d "${TMPDIR:-/tmp}/home-net-self-test.XXXXXX")" || exit 1
    trap 'rm -rf "$test_dir"' EXIT
    trap 'exit 1' HUP INT TERM
    PASS=0 FAIL=0
    expect() {
        if [ "$2" = "$3" ]; then
            printf 'PASS: %s\n' "$1"
            PASS=$((PASS + 1))
        else
            printf 'FAIL: %s (got %s, expected %s)\n' "$1" "$2" "$3"
            FAIL=$((FAIL + 1))
        fi
    }
    policy_file="$test_dir/policy"
    release_tag=v1.6.0
    AUTO_UPDATE_CAPABLE=1
    for scenario in manual:canary:0 canary:canary:1 canary:stable:0 fleet:stable:1 fleet:canary:1 invalid:stable:0; do
        rollout=${scenario%%:*}
        rest=${scenario#*:}
        ROLLOUT_RING=${rest%%:*}
        expected=${rest##*:}
        printf "POLICY_SCHEMA='1'\nRELEASE_TAG='v1.6.0'\nROLLOUT='%s'\n" "$rollout" > "$policy_file"
        evaluate_rollout_policy || true
        expect "$rollout/$ROLLOUT_RING auto apply" "$AUTO_APPLY_ALLOWED" "$expected"
        if [ "$rollout" = invalid ]; then
            expect 'invalid policy blocked' "$POLICY_STATUS" INVALID
        fi
    done
    printf "POLICY_SCHEMA='1'\nRELEASE_TAG='v1.5.4'\nROLLOUT='fleet'\n" > "$policy_file"
    evaluate_rollout_policy || true
    expect 'release mismatch' "$POLICY_STATUS" MISMATCH
    expect 'release mismatch blocks auto apply' "$AUTO_APPLY_ALLOWED" 0
    printf "POLICY_SCHEMA='1'\nRELEASE_TAG='v1.6.0'\nROLLOUT='fleet'\n" > "$policy_file"
    AUTO_UPDATE_CAPABLE=0
    evaluate_rollout_policy || true
    expect 'capable=0 blocks auto apply' "$AUTO_APPLY_ALLOWED" 0
    AUTO_UPDATE_CAPABLE=1
    printf "EVIL='1'\n" >> "$policy_file"
    evaluate_rollout_policy || true
    expect 'unsupported policy field blocked' "$POLICY_STATUS" INVALID

    HEALTH_STATE="$test_dir/health"
    for health in OK FAIL UNKNOWN ''; do
        printf 'STATUS=%s\nPODKOP=RUNNING\nSING_BOX=RUNNING\nFAKEIP=OK\nSERVICE_CHECK=OK\n' "$health" > "$HEALTH_STATE"
        result=0
        evaluate_health || result=$?
        expected=1
        [ "$health" != OK ] || expected=0
        expect "health ${health:-missing} gate" "$result" "$expected"
    done
    for self_required in PODKOP SING_BOX FAKEIP SERVICE_CHECK; do
        printf 'STATUS=OK\nPODKOP=RUNNING\nSING_BOX=RUNNING\nFAKEIP=OK\nSERVICE_CHECK=OK\n' | sed "/^$self_required=/d" > "$HEALTH_STATE"
        result=0
        evaluate_health || result=$?
        expect "missing $self_required blocks health" "$result" 1
    done
    active=1.5.4 release_version=1.6.0
    for UPDATE_ACTION_CLASS in SAFE CONTROLLED CRITICAL; do
        UPDATE_PENDING_ACTION=reboot
        result=0
        plan_update_action || result=$?
        expect "$UPDATE_ACTION_CLASS valid" "$result" 0
        expected=0
        [ "$UPDATE_ACTION_CLASS" != CRITICAL ] || expected=1
        expect "$UPDATE_ACTION_CLASS stage only" "$stage_only" "$expected"
        expected=0
        [ "$UPDATE_ACTION_CLASS" != CONTROLLED ] || expected=1
        expect "$UPDATE_ACTION_CLASS controlled preflight" "$controlled_action" "$expected"
        expected=OK expected_version=1.6.0
        if [ "$UPDATE_ACTION_CLASS" = CRITICAL ]; then
            expected=PENDING_APPLY expected_version=1.5.4
        fi
        expect "$UPDATE_ACTION_CLASS activation status" "$activation_status" "$expected"
        expect "$UPDATE_ACTION_CLASS active version" "$activation_version" "$expected_version"
    done
    UPDATE_ACTION_CLASS=CRITICAL UPDATE_PENDING_ACTION=none
    result=0
    plan_update_action || result=$?
    expect 'CRITICAL requires pending action' "$result" 1
    UPDATE_ACTION_CLASS=invalid
    result=0
    plan_update_action || result=$?
    expect 'invalid action class blocked' "$result" 1
    printf 'Self-test: %s passed, %s failed\n' "$PASS" "$FAIL"
    [ "$FAIL" -eq 0 ]
)

# Dispatch before dependencies, config validation, locking or runtime writes.
if [ "${1:-}" = self-test ]; then
    self_test
    exit $?
fi

for tool in curl grep sed tr logger; do need "$tool"; done
case "$CANARY" in 0|1) ;; *) die "HOME_NET_UPDATE_CANARY must be 0 or 1" ;; esac
case "$AUTO_UPDATE_CAPABLE" in 0|1) ;; *) die "HOME_NET_AUTO_UPDATE_CAPABLE must be 0 or 1" ;; esac
case "$ROLLOUT_RING" in canary|stable) ;; *) die "HOME_NET_ROLLOUT_RING must be canary or stable" ;; esac
for number in "$INTERVAL" "$JITTER" "$STARTUP_DELAY" "$COMMAND_TIMEOUT" "$HEALTH_TIMEOUT" "$HEALTH_RETRY_INTERVAL" "$HEALTH_MAX_BAD_CYCLES"; do
    valid_uint "$number" || die "update timing values must be non-negative integers"
done
[ "$COMMAND_TIMEOUT" -gt 0 ] || die "HOME_NET_UPDATE_COMMAND_TIMEOUT must be greater than zero"
[ "$HEALTH_TIMEOUT" -gt 0 ] || die "HOME_NET_UPDATE_HEALTH_TIMEOUT must be greater than zero"
[ "$HEALTH_RETRY_INTERVAL" -gt 0 ] || die "HOME_NET_UPDATE_HEALTH_RETRY_INTERVAL must be greater than zero"
[ "$HEALTH_MAX_BAD_CYCLES" -gt 0 ] || die "HOME_NET_UPDATE_HEALTH_MAX_BAD_CYCLES must be greater than zero"
case "${1:-}" in
    check) run_once check ;;
    apply) run_once apply ;;
    daemon) daemon ;;
    status) show_status ;;
    reconcile) run_once reconcile ;;
    auto) run_once auto ;;
    *) printf 'Usage: %s {check|apply|auto|daemon|status|self-test}\n' "$0" >&2; exit 2 ;;
esac
