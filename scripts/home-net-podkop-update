#!/bin/sh
# Separate Podkop operation: exact upstream assets, digests, dry-run, backup, rollback.
set -eu
fail() { echo "ERROR: $*" >&2; exit 1; }
LOCK=${HOME_NET_UPDATE_LOCK_DIR:-/var/run/home-net-update.lock}
ROOT=${HOME_NET_PODKOP_ROOT:-}
BACKUPS=${HOME_NET_MANAGEMENT_BACKUPS:-/root}
HEALTH=${HOME_NET_UPDATE_HEALTH_STATE:-/tmp/podkop-service-health/state}
PODKOP_INIT=${HOME_NET_PODKOP_INIT:-/etc/init.d/podkop}
case "${1:-}" in check|update) ;; *) fail 'expected check or update' ;; esac
operation="$1" confirmed="${2:-}"
current=$(podkop show_version 2>/dev/null) || fail 'cannot determine installed Podkop'
current=${current#v}
printf '%s\n' "$current" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || fail 'unsupported installed Podkop version'
work=$(mktemp -d /tmp/home-net-podkop.XXXXXX)
locked=0
cleanup() { rm -rf "$work"; [ "$locked" = 0 ] || { rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || true; }; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
fetch() { curl -fsSL --proto '=https' --connect-timeout 10 --max-time 120 "$1" -o "$2"; }
fetch 'https://api.github.com/repos/itdoginfo/podkop/releases/latest' "$work/latest.json"
latest=$(jsonfilter -i "$work/latest.json" -e '@.tag_name')
printf '%s\n' "$latest" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+$' || fail 'invalid Podkop release'
[ "$(jsonfilter -i "$work/latest.json" -e '@.draft')" = false ] || fail 'draft Podkop release'
[ "$(jsonfilter -i "$work/latest.json" -e '@.prerelease')" = false ] || fail 'prerelease Podkop release'
printf 'CURRENT=%s\nLATEST=%s\n' "$current" "$latest"
[ "$operation" = update ] || exit 0
[ "$confirmed" = "$latest" ] || fail 'latest Podkop changed; confirm again'
[ "${latest#v}" != "$current" ] || fail 'Podkop already current'
# Reject downgrades and unknown versions. Both package formats are independent of CPU.
awk -v a="${latest#v}" -v b="$current" 'BEGIN {split(a,x,"."); split(b,y,"."); for(i=1;i<=3;i++){if(x[i]>y[i])exit 0;if(x[i]<y[i])exit 1}exit 1}' || fail 'no upgrade available'
mkdir "$LOCK" 2>/dev/null || fail 'another update holds the lock'
locked=1
printf '%s\n' "$$" > "$LOCK/pid"
[ -r "$HEALTH" ] && grep -Fxq 'STATUS=OK' "$HEALTH" || fail 'health must be OK'
for item in PODKOP=RUNNING SING_BOX=RUNNING FAKEIP=OK SERVICE_CHECK=OK; do grep -Fxq "$item" "$HEALTH" || fail 'required health gate failed'; done
[ -r "$ROOT/etc/config/podkop" ] && [ -r "$ROOT/etc/config/network" ] || fail 'required configuration missing'
[ -r "$ROOT/etc/sing-box/config.json" ] || fail 'sing-box config missing; package plan unsupported'
if command -v apk >/dev/null 2>&1; then manager=apk; ext=apk; else command -v opkg >/dev/null 2>&1 || fail 'no package manager'; manager=opkg; ext=ipk; fi
fetch "https://api.github.com/repos/itdoginfo/podkop/releases/tags/$current" "$work/old.json"
assets() {
    metadata="$1" version="$2" destination="$3"
    mkdir "$destination"
    for package in podkop luci-app-podkop; do
        name=$(jsonfilter -i "$metadata" -e '@.assets[*].name' | grep -E "^$package-v?$version(-r[0-9]+)?(-all)?\.$ext$" | head -n 1)
        [ -n "$name" ] || fail "no $package $ext rollback-compatible asset"
        url=$(jsonfilter -i "$metadata" -e "@.assets[@.name='$name'].browser_download_url")
        digest=$(jsonfilter -i "$metadata" -e "@.assets[@.name='$name'].digest")
        case "$url" in https://github.com/itdoginfo/podkop/releases/download/*/"$name") ;; *) fail 'untrusted asset URL' ;; esac
        printf '%s\n' "$digest" | grep -Eq '^sha256:[0-9a-f]{64}$' || fail 'asset digest unavailable'
        fetch "$url" "$destination/$name"
        actual=$(sha256sum "$destination/$name" | awk '{print $1}')
        [ "$actual" = "${digest#sha256:}" ] || fail 'asset checksum mismatch'
    done
}
# Rollback packages are required before any mutation.
assets "$work/old.json" "$current" "$work/old"
assets "$work/latest.json" "${latest#v}" "$work/new"
install_packages() {
    directory="$1" dry="$2"
    if [ "$manager" = apk ]; then
        if [ "$dry" = 1 ]; then apk add --simulate --no-network --allow-untrusted "$directory/"*.apk; else apk add --no-network --allow-untrusted "$directory/"*.apk; fi
    else
        if [ "$dry" = 1 ]; then opkg --noaction install "$directory/"*.ipk; else opkg install "$directory/"*.ipk; fi
    fi
}
install_packages "$work/old" 1 > "$work/rollback-plan" 2>&1 || fail 'rollback dependency preflight failed'
install_packages "$work/new" 1 > "$work/plan" 2>&1 || fail 'package dependency preflight failed'
# Every planned package mutation must be one of the two explicit packages.
awk '/Installing |Upgrading |Downgrading |Removing |Reinstalling / {for(i=1;i<=NF;i++) if($i ~ /^(Installing|Upgrading|Downgrading|Removing|Reinstalling)$/){n=$(i+1); if(n!="podkop" && n!="luci-app-podkop")exit 1; count++}} END {if(count==0)exit 1}' "$work/plan" "$work/rollback-plan" || fail 'package plan would change unrelated dependencies or is unknown'
umask 077
backup="$BACKUPS/home-net-podkop-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$backup"
cp -p "$ROOT/etc/config/podkop" "$backup/podkop"
cp -p "$ROOT/etc/config/network" "$backup/network"
cp -p "$ROOT/etc/sing-box/config.json" "$backup/sing-box.json"
cp -p "$HEALTH" "$backup/health.state"
[ ! -d "$ROOT/tmp/podkop" ] || cp -Rp "$ROOT/tmp/podkop" "$backup/podkop-state"
[ ! -d "$ROOT/etc/sing-box" ] || cp -Rp "$ROOT/etc/sing-box" "$backup/sing-box-config"
cp -R "$work/old" "$backup/packages"
cp "$work/plan" "$backup/package-plan"
restore_config() {
    cp -p "$backup/podkop" "$ROOT/etc/config/podkop"
    cp -p "$backup/network" "$ROOT/etc/config/network"
    cp -p "$backup/sing-box.json" "$ROOT/etc/sing-box/config.json"
}
rollback() {
    install_packages "$backup/packages" 0 > "$backup/rollback.log" 2>&1 || { echo 'ROLLBACK FAILED: package restoration requires operator intervention' >&2; return 1; }
    restore_config || return 1
    "$PODKOP_INIT" restart || return 1
    restored=$(podkop show_version 2>/dev/null) || return 1
    [ "${restored#v}" = "$current" ] || return 1
    transaction_dirty=0
}
transaction_dirty=0
trap 'status=$?; if [ "$transaction_dirty" = 1 ]; then rollback || echo "ROLLBACK FAILED: operator intervention required; backup: $backup" >&2; fi; cleanup; exit "$status"' EXIT
before=$(sed -n 's/^LAST_CHECK=//p' "$HEALTH")
transaction_dirty=1
if ! install_packages "$work/new" 0 > "$backup/install.log" 2>&1; then rollback || true; fail "Podkop installation failed; backup: $backup"; fi
# Preserve original VPN/routing inputs. Never restart network or AWG.
if ! cmp -s "$backup/network" "$ROOT/etc/config/network" || ! cmp -s "$backup/podkop" "$ROOT/etc/config/podkop"; then rollback || true; fail "package changed protected configuration; rolled back: $backup"; fi
if ! "$PODKOP_INIT" restart; then rollback || true; fail "Podkop restart failed: $backup"; fi
[ "$(podkop show_version 2>/dev/null)" = "$latest" ] || [ "$(podkop show_version 2>/dev/null)" = "${latest#v}" ] || { rollback || true; fail 'installed Podkop version mismatch'; }
healthy=0
for attempt in $(seq 1 60); do
    sleep 10
    after=$(sed -n 's/^LAST_CHECK=//p' "$HEALTH")
    if [ -n "$after" ] && [ "$after" != "$before" ] && grep -Fxq 'STATUS=OK' "$HEALTH"; then
        healthy=1
        for item in PODKOP=RUNNING SING_BOX=RUNNING FAKEIP=OK SERVICE_CHECK=OK; do grep -Fxq "$item" "$HEALTH" || healthy=0; done
        [ "$healthy" = 0 ] || break
    fi
done
if [ "$healthy" != 1 ]; then rollback || true; fail "fresh health failed; rollback attempted: $backup"; fi
transaction_dirty=0
printf 'Podkop updated independently. Backup: %s\n' "$backup"