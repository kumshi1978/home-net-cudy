#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    [ -x /usr/sbin/vpn-control-cudy ] || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/vpn-control-cudy agent --loop
    procd_set_param env PATH=/usr/sbin:/usr/bin:/sbin:/bin GOMEMLIMIT=32MiB
    procd_set_param respawn 3600 10 5
    procd_set_param limits core="0 0"
    procd_set_param term_timeout 360
    procd_set_param stderr 1
    procd_close_instance
}
