# HOME NET updater local capability and permanent rollout role.
# Production target: all four Cudy capable; exactly one router uses ring=canary.
HOME_NET_AUTO_UPDATE_CAPABLE='1'
HOME_NET_ROLLOUT_RING='stable'
HOME_NET_ROLLOUT_POLICY_URL='https://raw.githubusercontent.com/kumshi1978/home-net-cudy/main/rollout-policy.conf'

# Legacy compatibility. Used only when both new rollout keys are absent.
HOME_NET_UPDATE_MODE='check'
HOME_NET_UPDATE_CANARY='0'

HOME_NET_UPDATE_INTERVAL='86400'
HOME_NET_UPDATE_JITTER='21600'
HOME_NET_UPDATE_STARTUP_DELAY='300'
HOME_NET_UPDATE_COMMAND_TIMEOUT='120'
HOME_NET_UPDATE_HEALTH_TIMEOUT='600'
HOME_NET_UPDATE_HEALTH_RETRY_INTERVAL='10'
HOME_NET_UPDATE_HEALTH_MAX_BAD_CYCLES='3'

# Local restrictions never override Git rollout or safety gates.
HOME_NET_AUTO_UPDATE_ENABLED='0'
HOME_NET_UPDATE_TIME='00:00'
HOME_NET_UPDATE_WINDOW_START='00:00'
HOME_NET_UPDATE_WINDOW_END='00:00'
# Jitter is stored in seconds; LuCI displays minutes. Equal window endpoints = all day.
